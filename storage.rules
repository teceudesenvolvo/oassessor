rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function ownsProfile(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }

    function isValidProfileImage() {
      return request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function validDemandAttachment() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument\\..*|application/vnd.ms-excel|text/plain)');
    }

    function belongsToPublishedProfile(adminId, profileSlug) {
      let profilePath = /databases/(default)/documents/publicProfiles/$(profileSlug);
      return firestore.exists(profilePath)
        && firestore.get(profilePath).data.userId == adminId
        && (!('enabled' in firestore.get(profilePath).data) || firestore.get(profilePath).data.enabled == true);
    }

    function managesAccount(adminId) {
      return request.auth != null && (
        request.auth.uid == adminId
        || (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.adminId == adminId)
      );
    }

    match /publicProfiles/{ownerId}/{fileName} {
      allow read: if true;
      allow create, update: if ownsProfile(ownerId) && isValidProfileImage();
      allow delete: if ownsProfile(ownerId);
    }

    match /publicProfiles/{ownerId}/blocks/{fileName} {
      allow read: if true;
      allow create, update: if ownsProfile(ownerId) && isValidProfileImage();
      allow delete: if ownsProfile(ownerId);
    }

    match /demandAttachments/{adminId}/{profileSlug}/{demandId}/{fileName} {
      allow create: if validDemandAttachment() && belongsToPublishedProfile(adminId, profileSlug);
      allow read, delete: if managesAccount(adminId);
    }
  }
}
